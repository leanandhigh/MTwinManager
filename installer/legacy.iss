; What a version from before the rename to MTwin Manager left on the PC, all in one place. Only
; ever removed: nothing new is installed under these names.
#define LegacyProgramDir "{autopf}\RoALT"
#define LegacyShortcut "RoALT.lnk"
#define LegacyDataDir "{localappdata}\RoALT"
#define LegacyWindowState "{userappdata}\com.inspectsoftware.roalt"
; tauri-plugin-single-instance's mutex while a version from before the rename runs.
#define LegacyMutex "com.inspectsoftware.roalt-sim"
